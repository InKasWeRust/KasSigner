diff -ruN a/esp-hal/ld/esp32p4/memory.x b/esp-hal/ld/esp32p4/memory.x
--- a/esp-hal/ld/esp32p4/memory.x
+++ b/esp-hal/ld/esp32p4/memory.x
@@ -4,6 +4,14 @@
    fixed at 0x4FFAE000 to leave the v3.x ROM BSS/stack region (top
    ~72 KB of L2MEM) untouched.
 
+   KASSIGNER ECO2 FIX (rev1.3, ROM esp32p4-eco2-20240710): on this silicon
+   the top 128 KB of L2MEM, 0x4FFA0000..0x4FFC0000, is not backed: writes
+   are dropped and reads return zero. Upstream's ceiling, 0x4FFADFC0, lies
+   inside it, so the main stack's locals read back as zero once evicted
+   from L1; the ceiling here is 0x4FFA0000. The ORIGIN stays as upstream
+   has it: the bottom 256 KB is real RAM, but the ROM and bootloader run
+   there.
+
    CONFIG numbers follow TRM Figure 7.3-2 (HP L2MEM Address Layout):
 
      CONFIG   ESP_HAL_CONFIG_L2_CACHE_SIZE   L2 cache    L2 RAM ORIGIN
@@ -26,13 +34,20 @@
 
 MEMORY
 {
-    RAM : ORIGIN = 0x4FF00000 + RESERVED_L2_CACHE, LENGTH = 0xADFC0 - RESERVED_L2_CACHE
+    /* KASSIGNER ECO2 FIX: ceiling 0x4FFA0000, not 0x4FFADFC0. See above.
+       LENGTH is 0xA0000 (the ceiling minus 0x4FF00000) less the cache. */
+    RAM : ORIGIN = 0x4FF00000 + RESERVED_L2_CACHE, LENGTH = 0xA0000 - RESERVED_L2_CACHE
 
     /* Memory available after the 2nd stage bootloader finishes.
        Upper bound is __stack_app = 0x4ffbefc0.
        Source: esp-idf C:\_Espressif\esp-idf\components\bootloader\subproject\main\ld\esp32p4\bootloader.memory.ld.in
+
+       KASSIGNER ECO2 FIX: on ECO2 all of it, 0x4FFA0000..0x4FFBEFC0, lies
+       in the unbacked top 128 KB, so it is given no length: a section
+       placed in it fails the link rather than losing its writes. Nothing
+       is placed there today.
     */
-    dram2_seg ( RW ): ORIGIN = ORIGIN(RAM) + LENGTH(RAM), len = 0x4ffbefc0 - (ORIGIN(RAM) + LENGTH(RAM))
+    dram2_seg ( RW ): ORIGIN = ORIGIN(RAM) + LENGTH(RAM), len = 0
 
     /* External flash (XIP via cache); +0x20 skips the IDF app image header. */
     ROM : ORIGIN = 0x40000000 + 0x20, LENGTH = 0x400000 - 0x20
diff -ruN a/esp-rom-sys/ld/esp32p4/rom-functions.x b/esp-rom-sys/ld/esp32p4/rom-functions.x
--- a/esp-rom-sys/ld/esp32p4/rom-functions.x
+++ b/esp-rom-sys/ld/esp32p4/rom-functions.x
@@ -1,7 +1,47 @@
 INCLUDE "rom/esp32p4.rom.api.ld"
-INCLUDE "rom/esp32p4.rom.eco5.ld"
+/* KASSIGNER ECO2 FIX -- the ECO5 jump table REPLACED by the ECO0 one.
+ *
+ * esp32p4.rom.eco5.ld is the table for chips whose ROM is at ECO 5 or above,
+ * which is silicon revision 3.x. These units are ECO2, so the table beside
+ * it is theirs: esp32p4.rom.ld, the one ESP-IDF links when the chip revision
+ * is below 3.0.
+ *
+ * Diffed, the two tables share 456 symbols and disagree about 237 of them.
+ * The build worked anyway because the handful esp-hal calls on this chip --
+ * ets_delay_us, ets_update_cpu_frequency, the uart_tx routines,
+ * software_reset, ets_set_appcpu_boot_addr, Cache_WriteBack_Addr and
+ * Cache_Invalidate_Addr -- happen to sit at the same address in both. That
+ * is luck, not compatibility: ets_efuse_read and every crc routine do not,
+ * and one wrong binding is already in the tree, unused --
+ * rtc_clk_xtal_freq_get reaching ets_clk_get_xtal_freq at 0x4fc00550 where
+ * this ROM has it at 0x4fc0055c.
+ *
+ * The failure mode is the one this patch already documents below: the chip
+ * jumps into whatever routine occupies that address and runs it, silently,
+ * exactly as __udivdi3 did.
+ */
+INCLUDE "rom/esp32p4.rom.ld"
-INCLUDE "rom/esp32p4.rom.eco5.libgcc.ld"
-INCLUDE "rom/esp32p4.rom.eco5.rvfp.ld"
+/* KASSIGNER ECO2 FIX -- libgcc ROM routines REMOVED.
+ *
+ * esp32p4.rom.eco5.libgcc.ld states: "Compatible with ROM where ECO version
+ * equal or greater to 5." This chip runs ECO2 (rom_eco_version = 2), so all
+ * 75 of its symbols resolve to WRONG addresses.
+ *
+ * riscv32imafc has no 64-bit divide instruction, so `u64 / u64` calls
+ * __udivdi3 -- which landed in the wrong ROM routine and returned
+ * `sum - count` instead of `sum / count`. Silently. With plausible numbers.
+ * 32-bit division is a hardware `divu` and was always fine, which is what
+ * made it so hard to spot.
+ *
+ * For a signing device this is a correctness hazard, not a nuisance: u64
+ * and u128 arithmetic is exactly what key handling and amount maths use.
+ *
+ * With this INCLUDE removed, compiler_builtins provides the routines in
+ * software. Slightly slower, correct on every ROM revision.
+ */
+/* INCLUDE "rom/esp32p4.rom.eco5.libgcc.ld" */
+/* Same ECO5-only caveat applies to the float routines. */
+/* INCLUDE "rom/esp32p4.rom.eco5.rvfp.ld" */
 INCLUDE "rom/esp32p4.rom.version.ld"
 
 INCLUDE "rom/additional.ld"
