-                        out("t0") _,
-                    );
-                }
+                // ===== KASSIGNER ECO2 CHANGE =====
+                // The mintthresh workaround above targets v3.2/ECO7 silicon.
+                // CSR 0x347 is a CLIC register; on ECO2 it appears not to be
+                // implemented, so `csrrw 0x347` traps and the lock never
+                // returns. That single fault explains every hang seen so far:
+                // critical_section::with() before init(), and
+                // system::disable_peripherals()'s NonReentrantMutex.
+                //
+                // Set ESP_HAL_KASSIGNER_SKIP_MINTTHRESH=0 at build time to
+                // restore upstream behaviour.
+                let skip_mintthresh = option_env!("ESP_HAL_KASSIGNER_SKIP_MINTTHRESH") != Some("0");
+
+                let old_mintthresh: u32 = if skip_mintthresh {
+                    0
+                } else {
+                    let v: u32;
+                    unsafe {
+                        core::arch::asm!(
+                            "li   t0, 0xff",
+                            "csrrw {0}, 0x347, t0",
+                            out(reg) v,
+                            out("t0") _,
+                        );
+                    }
+                    v
+                };
                 let mut mstatus = 0u32;
                 unsafe {
