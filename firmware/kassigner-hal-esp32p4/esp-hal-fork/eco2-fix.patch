-                let token = mie_bit | ((old_mintthresh & 0xff) << 8);
+                // Bit 16 records whether mintthresh was actually touched, so
+                // exit() knows not to write CSR 0x347 back.
+                let token = mie_bit
+                    | ((old_mintthresh & 0xff) << 8)
+                    | if skip_mintthresh { 1 << 16 } else { 0 };
             }
             riscv => {
                 let mut mstatus = 0u32;
@@ -103,12 +124,15 @@
                     }
                 }
                 // Restore mintthresh AFTER re-enabling mie (P4 Zcmp workaround, see enter()).
-                let old_mintthresh = (token >> 8) & 0xff;
-                unsafe {
-                    core::arch::asm!(
-                        "csrw 0x347, {0}",
-                        in(reg) old_mintthresh,
-                    );
+                // KASSIGNER: bit 16 means enter() skipped the CSR entirely.
+                if (token & (1 << 16)) == 0 {
+                    let old_mintthresh = (token >> 8) & 0xff;
+                    unsafe {
+                        core::arch::asm!(
+                            "csrw 0x347, {0}",
+                            in(reg) old_mintthresh,
