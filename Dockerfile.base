# KasSigner — Air-gapped offline signing device for Kaspa
# Copyright (C) 2025-2026 KasSigner Project (kassigner@proton.me)
# License: GPL-3.0
#
# Frozen toolchain base image (build once, reuse forever)

# Pinned by CONTENT DIGEST, not by tag. `ubuntu:24.04` is mutable: Canonical
# republishes it for security updates while the tag stays the same, so two
# people building this file months apart were getting different base layers
# and therefore, potentially, different firmware hashes. The digest below
# always resolves to exactly one image.
#
# Pinned 2026-08-03. To move it forward deliberately:
#   docker pull ubuntu:24.04
#   docker inspect --format='{{index .RepoDigests 0}}' ubuntu:24.04
# then bump the toolchain tag (v3 -> v4) so the old and new images cannot
# share a name.
FROM --platform=linux/amd64 ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# ============================================================
# KasSigner — Toolchain Base Image v3 (build once, reuse forever)
# ============================================================
# Forces x86_64 platform for identical hashes across all hosts.
#
#   docker build --platform linux/amd64 -f Dockerfile.base -t kassigner-toolchain:v3 .
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root

# Package versions pinned as installed on 2026-08-03, from the pinned base
# image above. Without these, `apt-get install gcc` fetches whatever the Ubuntu
# archive serves that day, which is the last unpinned input to the build.
#
# NOTE ON EXPIRY: Ubuntu's archive keeps only current versions. When a security
# update supersedes one of these, the exact version disappears and this build
# FAILS LOUDLY with "version not found" rather than silently using a different
# compiler. That is the intended failure mode. To move forward deliberately,
# re-read the versions from a fresh image and bump the toolchain tag with them:
#
#   docker run --rm --platform linux/amd64 <image> \
#     dpkg-query -W -f='${Package}=${Version}\n' curl gcc g++ pkg-config \
#     libssl-dev libusb-1.0-0-dev libudev-dev ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates=20260601~24.04.1 \
    curl=8.5.0-2ubuntu10.11 \
    gcc=4:13.2.0-7ubuntu1 \
    g++=4:13.2.0-7ubuntu1 \
    libssl-dev=3.0.13-0ubuntu3.12 \
    libudev-dev=255.4-1ubuntu8.16 \
    libusb-1.0-0-dev=2:1.0.27-1 \
    pkg-config=1.8.1-2build1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.85.0
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl -L "https://github.com/esp-rs/espup/releases/download/v0.16.0/espup-x86_64-unknown-linux-gnu" \
    -o /usr/local/bin/espup && chmod +x /usr/local/bin/espup

# Xtensa Rust toolchain pinned explicitly. Without `--toolchain-version`,
# espup queries GitHub for the LATEST Xtensa Rust release at build time, so the
# same Dockerfile would install a different cross-compiler as esp-rs publishes
# new versions. That is the compiler producing the firmware, so it is the one
# input that must not float.
#
# 1.95.0.0 is what espup 0.16.0 resolved on 2026-08-03. To move it forward,
# change the version here and bump the toolchain tag (v3 -> v4).
RUN espup install --toolchain-version 1.95.0.0 --export-file /root/esp-env.sh

SHELL ["/bin/bash", "-c"]
ENV PATH="/root/.rustup/toolchains/esp/bin:${PATH}"

RUN source /root/esp-env.sh && rustc --version && cargo --version
