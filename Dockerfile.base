# KasSigner — Air-gapped offline signing device for Kaspa
# Copyright (C) 2025-2026 KasSigner Project (kassigner@proton.me)
# License: GPL-3.0
#
# Frozen toolchain base image assembled only from host-prefetched, SHA-256
# inventoried inputs. The caller must build this Dockerfile with
# --network=none. No Dockerfile instruction downloads anything.
FROM kassigner-ubuntu-rootfs:v1

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root
SHELL ["/bin/bash", "-c"]

# The generated build context contains only inputs that were acquired on the
# host before Docker starts and inventoried in BUILD-INPUT-SHA256SUMS.
COPY . /opt/kassigner/input/

RUN cd /opt/kassigner/input && sha256sum -c BUILD-INPUT-SHA256SUMS
# The .debs were acquired from the pinned Ubuntu snapshot during host
# prefetch and are authenticated here by the SHA-256 inventory.  The host also
# emits a deterministic Packages index for exactly that closure.  Docker APT
# sees only this file:// repository; Docker networking is disabled by the
# caller, so no package can come from an external repository.
RUN cd /opt/kassigner/input && sha256sum -c DEBS-SHA256SUMS && \
    rm -rf /tmp/kassigner-apt-lists && mkdir -p /tmp/kassigner-apt-lists/partial && \
    apt-get \
      -o Dir::Etc::sourcelist=/opt/kassigner/input/apt-state/sources.container.list \
      -o Dir::Etc::sourceparts=- \
      -o Dir::State::lists=/tmp/kassigner-apt-lists \
      -o Acquire::Languages=none \
      update && \
    apt-get \
      -o Dir::Etc::sourcelist=/opt/kassigner/input/apt-state/sources.container.list \
      -o Dir::Etc::sourceparts=- \
      -o Dir::State::lists=/tmp/kassigner-apt-lists \
      -o Acquire::Languages=none \
      install -y --no-install-recommends /opt/kassigner/input/debs/*.deb && \
    dpkg --audit && \
    rm -rf /tmp/kassigner-apt-lists /var/lib/apt/lists/*

COPY qa/config/toolchains.env /etc/kassigner/toolchains.env
RUN cp -a /opt/kassigner/input/root-home/. /root/ && \
    cd /root && sha256sum -c /opt/kassigner/input/TOOLCHAIN-SHA256SUMS

ENV PATH="/root/.cargo/bin:/root/.rustup/toolchains/esp/bin:${PATH}"
ENV CARGO_NET_OFFLINE=true

# espflash is compiled inside the Docker toolchain image, but exclusively from
# the Cargo cache populated during the host prefetch phase.
RUN source /etc/kassigner/toolchains.env && \
    cargo "+$KASSIGNER_REPRO_HOST_RUST" install espflash \
      --offline --locked --version "$KASSIGNER_ESPFLASH_VERSION" --force

RUN source /etc/kassigner/toolchains.env && \
    rustc "+$KASSIGNER_REPRO_HOST_RUST" --version && \
    rustup target list --toolchain "$KASSIGNER_REPRO_HOST_RUST" --installed | grep -qx wasm32-unknown-unknown && \
    source /root/esp-env.sh && \
    python3 --version && \
    rustc --version && cargo --version && espflash --version
